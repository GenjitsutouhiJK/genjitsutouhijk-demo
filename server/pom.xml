<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.1.1</version>
		<relativePath/> <!-- lookup parent from repository -->
	</parent>
	<groupId>io.github.genjitsutouhijk</groupId>
	<artifactId>genjitsutouhijk-demo</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name/>
	<description/>
	<url/>
	<licenses>
		<license/>
	</licenses>
	<developers>
		<developer/>
	</developers>
	<scm>
		<connection/>
		<developerConnection/>
		<tag/>
		<url/>
	</scm>
	<properties>
		<java.version>21</java.version>
		<!-- JJWT 不在 Spring Boot 的 BOM 里，版本必须自己写。
		     生命周期统一用同一个属性，避免 api / impl / jackson 三个包版本错位
		     （版本不一致时会在运行时抛 NoSuchMethodError，很难查）。 -->
		<jjwt.version>0.13.0</jjwt.version>
	</properties>
	<dependencies>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc</artifactId>
		</dependency>

		<!-- 参数校验：提供 @NotBlank / @Size 这类注解，以及校验它们的引擎 -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>

		<!-- 持久层：Spring Data JPA + Hibernate。
		     提供 @Entity 注解、EntityManager、事务管理，以及"只写接口就能用的" Repository。 -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa</artifactId>
		</dependency>

		<!-- 建表脚本管理：用带版本号的 SQL 文件建表、改表，而不是让 Hibernate 自动改表结构。
		     注意 Boot 4 里这个 starter 就叫 spring-boot-starter-flyway，
		     不像 Boot 3 那样"自己往 pom 里加 flyway-core"。 -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-flyway</artifactId>
		</dependency>

		<!-- H2 数据库：一个 jar 就能跑，不用安装任何数据库服务。
		     版本由 Spring Boot 的 BOM 统一管理（4.1.1 对应 2.4.240），所以这里不写 <version>。
		     scope=runtime：代码里不直接 import H2 的类，只在运行时用它的驱动。 -->
		<dependency>
			<groupId>com.h2database</groupId>
			<artifactId>h2</artifactId>
			<scope>runtime</scope>
		</dependency>

		<!-- 安全框架本体（里程碑 ③ 才加）。
		     里程碑 ② 时这里只有 spring-security-crypto（纯工具包，只为了拿 BCryptPasswordEncoder）。
		     换成 starter 之后：
		       - BCryptPasswordEncoder 仍然可用（crypto 是它的传递依赖），PasswordConfig 一个字没改；
		       - 多出来的是一整条**安全过滤器链**，默认会拦下所有请求并要求登录。
		     所以这个依赖一加，SecurityConfig 就必须同步跟上，否则所有接口都会 401。 -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-security</artifactId>
		</dependency>

		<!-- JWT 工具库 JJWT。它被拆成三个包，分工是刻意的：
		       jjwt-api    —— 编译期用的接口（Jwts.builder()、Jwts.parser() 等），我们的代码只依赖它；
		       jjwt-impl   —— 真正的实现，scope=runtime，编译期看不到，防止误用到内部类；
		       jjwt-jackson—— 让 JWT 的 JSON 部分交给 Jackson 处理。
		     为什么要这么分？以后想换掉 impl（比如换个更快的实现），只要运行时换 jar，
		     我们的业务代码一行都不用改 —— 和 PasswordEncoder 那个思路一样。
		     ⚠️ 注意 jjwt-jackson 依赖的是 Jackson 2（com.fasterxml.jackson），
		        而 Spring Boot 4 主用的是 Jackson 3（tools.jackson）。两者包名不同，
		        可以共存、不会打架，只是会多几个 jar，功能上没有影响。 -->
		<dependency>
			<groupId>io.jsonwebtoken</groupId>
			<artifactId>jjwt-api</artifactId>
			<version>${jjwt.version}</version>
		</dependency>
		<dependency>
			<groupId>io.jsonwebtoken</groupId>
			<artifactId>jjwt-impl</artifactId>
			<version>${jjwt.version}</version>
			<scope>runtime</scope>
		</dependency>
		<dependency>
			<groupId>io.jsonwebtoken</groupId>
			<artifactId>jjwt-jackson</artifactId>
			<version>${jjwt.version}</version>
			<scope>runtime</scope>
		</dependency>

		<!-- H2 的网页控制台：浏览器里直接看表、跑 SQL 的小工具。
		     ⚠️ Boot 4 的一个坑：它被拆成了独立模块，不再是自动配置里自带的东西。
		     光在 application.properties 里写 spring.h2.console.enabled=true 是没用的，
		     不加这个依赖，访问 /h2-console 会得到 404。 -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-h2console</artifactId>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-devtools</artifactId>
			<scope>runtime</scope>
			<optional>true</optional>
		</dependency>
		<dependency>
			<groupId>org.projectlombok</groupId>
			<artifactId>lombok</artifactId>
			<optional>true</optional>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc-test</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<executions>
					<execution>
						<id>default-compile</id>
						<phase>compile</phase>
						<goals>
							<goal>compile</goal>
						</goals>
						<configuration>
							<annotationProcessorPaths>
								<path>
									<groupId>org.projectlombok</groupId>
									<artifactId>lombok</artifactId>
								</path>
							</annotationProcessorPaths>
						</configuration>
					</execution>
					<execution>
						<id>default-testCompile</id>
						<phase>test-compile</phase>
						<goals>
							<goal>testCompile</goal>
						</goals>
						<configuration>
							<annotationProcessorPaths>
								<path>
									<groupId>org.projectlombok</groupId>
									<artifactId>lombok</artifactId>
								</path>
							</annotationProcessorPaths>
						</configuration>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>

</project>
